# ==============================================================================
# GSDD Foundation - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Google Cloud Run), configure these variables via Google Cloud
# Secret Manager and Cloud Run environment variable bindings.
#
# SECURITY WARNING:
# Do NOT commit actual credentials, passwords, or secrets to version control.
# Keep all placeholders blank in committed template files.
# ==============================================================================

# ------------------------------------------------------------------------------
# Admin Authentication Configuration (app/lib/admin-auth.js)
# ------------------------------------------------------------------------------

# ADMIN_USERNAME
# Required. Printable username (1 to 128 characters) for admin portal login.
ADMIN_USERNAME=

# ADMIN_PASSWORD_HASH
# Required. Scrypt password hash formatted strictly as "<salt>:<hash>":
#   - <salt>: 16 to 128 hexadecimal characters.
#   - <hash>: 128 lowercase hexadecimal characters (64 scrypt output bytes).
# NOTE: The scrypt key derivation treats the hex salt as a literal UTF-8 text string.
#
# Generate this value interactively (with hidden password input) using:
#   node scripts/create-admin-password.mjs
ADMIN_PASSWORD_HASH=

# ADMIN_SESSION_SECRET
# Required. Cryptographic signing key for stateless HMAC session tokens.
# Must be at least 32 non-whitespace characters (e.g., a 64-character random hex string).
# Rotating this secret immediately invalidates all outstanding admin sessions.
# Example generation:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# Gallery Storage Configuration (app/lib/gallery-store.js)
# ------------------------------------------------------------------------------

# GALLERY_BUCKET
# Name of the Google Cloud Storage (GCS) bucket for storing uploaded gallery photos
# and gallery metadata.
#
# - Local Development:
#     Leave blank or unset to store uploads on the local filesystem under .data/gallery/.
# - Production (Google Cloud Run):
#     MANDATORY. Gallery writes fail closed without a production bucket.
#     Cloud Run's ephemeral disk cannot preserve uploads across instances.
GALLERY_BUCKET=
